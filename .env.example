# Copia este archivo como .env para probar en tu computadora (npm start).
# En Easypanel se capturan en la pestaña Environment del servicio.

# Postgres del VPS. Formato: postgres://USUARIO:CONTRASEÑA@IP_DEL_VPS:PUERTO/BASE
DATABASE_URL=postgres://bitacora:CONTRASEÑA@IP_DEL_VPS:5432/bitacora

# IA (opcional: sin ella la app funciona, pero sin transcripción ni redacción automática)
GEMINI_API_KEY=
GEMINI_MODEL=
